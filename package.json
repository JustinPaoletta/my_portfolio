{
  "name": "my-portfolio",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "build": "npm run type-check && npm run contrast:check && node ./node_modules/vite/bin/vite.js build && npm run prerender",
    "build:analyze": "npm run type-check && ANALYZE=true node ./node_modules/vite/bin/vite.js build && npx --yes vite-bundle-visualizer@1.2.1",
    "capture:hero-posters": "tsx scripts/capture-hero-posters.ts",
    "clean:cache": "rm -rf dist coverage .vite .lighthouseci playwright-report test-results",
    "contrast:check": "tsx scripts/contrast-check.ts",
    "generate:icons": "node scripts/generate-icons.mjs",
    "optimize:project-logos": "node scripts/optimize-project-logos.mjs",
    "lighthouse": "npx @lhci/cli autorun",
    "lint": "npm run lint:ci",
    "lint:ci": "npm run type-check && eslint src api server e2e plugins scripts vite.config.ts vitest.config.ts vitest.server.config.ts playwright.config.ts eslint.config.js commitlint.config.js .lighthouserc.cjs && prettier --check .",
    "lint:fix": "npm run type-check && eslint src api server e2e plugins scripts vite.config.ts vitest.config.ts vitest.server.config.ts playwright.config.ts eslint.config.js commitlint.config.js .lighthouserc.cjs --fix && prettier --write .",
    "nuke": "rm -rf node_modules package-lock.json dist coverage .vite .lighthouseci playwright-report test-results .vercel",
    "prepare": "husky",
    "start:dev": "node ./node_modules/vite/bin/vite.js",
    "start:vercel": "vercel dev --listen 6173",
    "start:prod": "npm run build && node ./node_modules/vite/bin/vite.js preview --strictPort --port 4173",
    "test": "vitest",
    "test:a11y": "npm run test:a11y:unit && npm run test:a11y:e2e",
    "test:a11y:e2e": "playwright test --grep @a11y",
    "test:a11y:unit": "vitest run --config vitest.a11y.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "vitest --coverage --ui",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:e2e:debug": "playwright test --grep-invert @visual --debug",
    "test:e2e:ui": "playwright test --grep-invert @visual --ui",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run && vitest run --config vitest.server.config.ts",
    "test:visual": "VITE_GITHUB_API_ENABLED=true playwright test --project=visual-chromium --grep @visual",
    "test:visual:update": "VITE_GITHUB_API_ENABLED=true playwright test --project=visual-chromium --grep @visual --update-snapshots",
    "test:visual:update:linux": "./scripts/run-visual-linux.sh --update-snapshots=all",
    "type-check": "tsc -b --noEmit && tsc -p tsconfig.server.json",
    "type-check:watch": "tsc -b --noEmit --watch",
    "prerender": "tsx scripts/prerender.ts"
  },
  "dependencies": {
    "@newrelic/browser-agent": "^1.312.1",
    "@react-three/fiber": "^9.6.1",
    "@upstash/redis": "^1.37.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vercel/node": "5.10.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.0.2",
    "lightningcss": "^1.32.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "sharp": "0.35.5",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.2",
    "vercel": "54.21.1",
    "vite": "npm:rolldown-vite@7.1.14",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "4.1.11",
    "workbox-window": "^7.4.0"
  },
  "overrides": {
    "chrome-launcher": "^1.2.1",
    "esbuild": "~0.27.0",
    "magic-string": "^0.30.0",
    "tmp": ">=0.2.4",
    "fflate": "^0.8.3",
    "tar": "^7.5.22",
    "undici@<7": "^6.29.0",
    "@fastify/busboy": "^3.2.1",
    "@tootallnate/once": "^2.0.1",
    "ajv@>=8 <8.18.0": "^8.18.0",
    "basic-ftp": "^6.2.1",
    "js-yaml@>=4 <4.3.2": "^4.3.2",
    "minimatch@>=10 <10.2.3": "^10.2.3",
    "path-to-regexp@>=6 <6.3.0": "^6.3.0",
    "path-to-regexp@>=8 <8.4.0": "^8.4.0",
    "smol-toml": "^1.9.0",
    "uuid@>=8 <11.1.1": "^11.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "npm@11.6.4"
}
